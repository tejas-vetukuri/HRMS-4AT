# Base URL of the HRMS backend API (server-side only; used by Next.js route
# handlers under src/app/api/* to proxy requests to the backend).
# Copy this file to .env.local and adjust as needed.
BACKEND_API_URL=http://localhost:3000/api/v1

# Temporary: set to "true" to sign in without a running backend (see
# src/lib/api/mock-auth.ts). Any email/password is accepted; /users/me and the
# profile-update endpoint return a fake org-scoped admin user instead of
# calling BACKEND_API_URL. Remove this once the real /auth and /users/me
# endpoints exist (docs/TASKS.md Phase 1).
MOCK_AUTH=true
